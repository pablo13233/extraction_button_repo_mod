<Project>
  <PropertyGroup>
    <!-- Default paths (can be overridden in Directory.Build.props.user) -->
    <RepoGameRoot Condition="'$(RepoGameRoot)' == ''">E:\SteamLibrary\steamapps\common\REPO</RepoGameRoot>
    <BepInExProfileRoot Condition="'$(BepInExProfileRoot)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\REPO\profiles\REPOS</BepInExProfileRoot>
    <DeployToProfile Condition="'$(DeployToProfile)' == ''">true</DeployToProfile>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <PropertyGroup>
    <RepoManagedDir>$(RepoGameRoot)\REPO_Data\Managed</RepoManagedDir>
    <BepInExCoreDir>$(BepInExProfileRoot)\BepInEx\core</BepInExCoreDir>
    <BepInExPluginsDir>$(BepInExProfileRoot)\BepInEx\plugins</BepInExPluginsDir>
  </PropertyGroup>
</Project>

